# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
max_line_length = 80

[*.{md,yml}]
max_line_length = off
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

[*.txt]
insert_final_newline = false

# shfmt reads these, also for scripts with a shebang and no extension
[[shell]]
indent_style = tab
switch_case_indent = true

# Copied from grub-holdshift, kept as upstream wrote it
[modules/grub/resources/31_hold_shift]
ignore = true

# shfmt 3.14 changes the meaning of some zsh expansions, such as $((...))
# inside ${${(M)...}}. A shfmt walk of the tree also finds zsh scripts without
# an extension: add each one to the list below. The make targets list only sh,
# bash, dash and ksh scripts.
[*.zsh]
ignore = true

[{modules/home/XDG_BIN_HOME.home/colormap,modules/home/XDG_BIN_HOME.home/paku}]
ignore = true
