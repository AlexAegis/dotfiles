# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
max_line_length = 80

[*.{md,yml}]
max_line_length = off
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

[*.txt]
insert_final_newline = false

[[shell]]
indent_style = tab
switch_case_indent = true

[modules/grub/resources/31_hold_shift]
ignore = true

[*.zsh]
ignore = true

[{modules/home/XDG_BIN_HOME.home/colormap,modules/home/XDG_BIN_HOME.home/paku}]
ignore = true
