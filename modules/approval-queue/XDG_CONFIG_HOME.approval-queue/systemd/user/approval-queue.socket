[Unit]
Description=Socket for the permission prompts of coding agent sessions

[Socket]
# 2.root.sh creates the folder: 2750, group agent, so the socket gets group agent
ListenStream=/run/approval-queue/request.sock
SocketMode=0660
RemoveOnStop=yes
# A service process for each waiting prompt
Accept=yes
MaxConnections=64
# One user cannot take every place
MaxConnectionsPerSource=48

[Install]
WantedBy=sockets.target
