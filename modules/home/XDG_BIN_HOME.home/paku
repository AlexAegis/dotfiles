#!/bin/zsh

set -euo pipefail
trap 'printf "paku: command failed on line %s (exit %s)\n" "$LINENO" "$?" >&2' ERR

as_user() {
    if [[ -n ${SUDO_USER:-} ]]; then
        sudo -u "$SUDO_USER" "$@"
    else
        "$@"
    fi
}

# Updates packages

if command -v apt > /dev/null; then
    echo "Updating packages using apt..."
    sudo apt update
	sudo apt upgrade -y
fi

if command -v brew > /dev/null; then
    echo "Updating packages using brew..."
	as_user brew update
	as_user brew upgrade
fi

if command -v pacman > /dev/null; then
    echo "Updating packages using pacman..."
    sudo pacman -Syu --noconfirm
fi

if command -v aura > /dev/null; then
    echo "Updating AUR packages using aura..."
    aura_log=$(mktemp)
    trap 'rm -f -- "$aura_log"' EXIT
    # Clean successful builds so a later release cannot reuse stale binaries.
    as_user env LANG=en_US.UTF-8 aura -Ayu --clean --noconfirm 2>&1 | tee "$aura_log"
    # Aura can return zero even when individual packages failed to build.
    if grep -Eq 'Package failed to build|Calling the metadata server utterly failed' "$aura_log"; then
        echo "paku: AUR update incomplete; see the errors above." >&2
        exit 1
    fi
	as_user aura -Bc --noconfirm # remove stale snapshots
	as_user aura check # diagnostics
fi

if command -v dnf > /dev/null; then
    echo "Updating packages using dnf..."
    sudo dnf upgrade --refresh -y
fi

if command -v zypper > /dev/null; then
    echo "Updating packages using zypper..."
    sudo zypper refresh
	sudo zypper update -y
fi

if command -v xbps-install > /dev/null; then
    echo "Updating packages using xbps..."
    sudo xbps-install -Su
fi
