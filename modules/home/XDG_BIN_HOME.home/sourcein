#!/bin/sh
# source everything in a folder
# Save IFS so callers (e.g. sddm's wayland-session "exec $@") still
# word-split correctly after sourcein returns.
_sourcein_old_ifs="${IFS-__unset__}"
IFS='
'
set -af
# DIR and REGEX only: when sourced, $1 and $2 belong to the caller
# Can ignore because globbing is disabled with the `f` flag
# shellcheck disable=SC2044
for f in $(find "$DIR" -mindepth 1 -maxdepth 1 -regex "$REGEX" | sort)
do
	[ ! "$QUIET" ] && echo "Sourcing $f"
	# shellcheck disable=SC1090
	[ -e "$f" ] && . "$f"
	ret="$?"
	# The kde module's env.sh matches this message
	[ "$ret" != 0 ] && printf '%s\n' "Return value of $f is $ret"
done
set +af
if [ "$_sourcein_old_ifs" = "__unset__" ]; then
	unset IFS
else
	IFS="$_sourcein_old_ifs"
fi
unset -v _sourcein_old_ifs f ret
